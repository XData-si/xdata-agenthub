# Verified MCP phase 1: listed servers (L0 = metadata only) and one entry.
Output demos/recordings/out/mcp.mp4
Output demos/recordings/out/mcp.gif
Source demos/recordings/settings.tape
Set FontSize 24

Hide
Type "export PS1='$ ' && alias xah='python3 cli/xah.py' && clear" Enter
Show
Type "xah mcp list" Enter
Sleep 4s
Type "xah mcp inspect sentry" Enter
Sleep 6s
